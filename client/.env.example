# SplitMate Frontend Environment Configuration

# Optional backend URL (leave blank if using Vite dev proxy in development)
VITE_API_BASE_URL=

# Google OAuth 2.0 Web Client ID from Google Cloud Console
# Note: Google OAuth consent screen in testing mode requires test user emails to be configured.
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
